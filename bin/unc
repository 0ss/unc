#!/usr/bin/env bash
# unc — tiny CLI. Toggle the rule, read your numbers.
set -euo pipefail

UNC_DIR="$HOME/.unc"
LOG="$UNC_DIR/sessions.ndjson"
VERSION="0.1.0"
mkdir -p "$UNC_DIR"

usage() {
  cat <<'EOF'
unc — your lazy senior dev, equipped.

  unc stats            what the benchmark tracked + savings (honest, tiered)
  unc stats --share    a copy-paste receipt card for the timeline
  unc stats --svg      render the card as a shareable sloth svg (~/.unc/receipt.svg)
  unc stats --how      how the numbers are calculated (+ link to METHODOLOGY.md)
  unc on | off         turn the always-on rule on or off
  unc status           one-line status (for a statusline)
  unc where            print paths unc uses
  unc uninstall        remove unc (hooks + cli); keeps your log
  unc version          print version
  unc help             this

The rule (ponytail + caveman + codedb) and the benchmark run from hooks.
EOF
}

how() {
  cat <<'EOF'
big unc's math (a guesstimate — you only did each task once):

  tokens saved = your output × 65%   (caveman)
  lines saved  = your lines  × 54%   (ponytail)
  $ saved      = tokens saved × UNC_PRICE   (output only, never cache)
  codedb: counts queries × ~1500 tokens not read; not in $

  different axes, no double-count. details → METHODOLOGY.md
EOF
}

humanize() {  # 12655480 -> 12.6M ; 8300 -> 8k
  local n=${1:-0}
  if [ "$n" -ge 1000000 ]; then printf '%d.%dM' $((n/1000000)) $(((n%1000000)/100000))
  elif [ "$n" -ge 1000 ]; then printf '%dk' $((n/1000))
  else printf '%d' "$n"; fi
}

seg() { local e=$'\033' n="$2" i; printf '%s[38;2;%sm' "$e" "$1"; for ((i=0;i<n;i++)); do printf '█'; done; }

# the receipt card — warm/brown truecolor, 🦥 header, one combined loadout bar.
# rendered in bash so the text is free of jq escaping. needs a truecolor terminal.
render_card() {  # tok usd opct conf turns cdbq cdbsaved
  local e=$'\033' r=$'\033[0m' b=$'\033[1m'
  local tok="$1" usd="$2" opct="$3" conf="$4" turns="$5" cdbq="${6:-0}" cdbsav="${7:-0}"
  printf '\n   🦥  %s[38;2;212;170;110m%sunc wrapped%s   %s[38;2;150;120;85m%s%s\n\n' "$e" "$b" "$r" "$e" "$conf" "$r"
  printf '   %s[38;2;236;186;96m%s%s%s   %s[38;2;190;160;120moutput tokens saved%s   %s[38;2;230;170;80m~$%s%s\n\n' \
    "$e" "$b" "$(humanize "$tok")" "$r" "$e" "$r" "$e" "$usd" "$r"
  # one combined loadout bar — three tool-colored segments
  printf '   '; seg '208;132;60' 9; seg '222;176;92' 8; seg '150;110;70' 7; printf '%s\n' "$r"
  printf '   %s[38;2;170;140;110mcaveman -65%% out · ponytail -54%% code · codedb %sq%s\n\n' "$e" "$cdbq" "$r"
  printf '   %s[38;2;140;120;95m%s turns · trust me bro · math → unc stats --how · github.com/0ss/unc%s\n\n' "$e" "$turns" "$r"
}

case "${1:-help}" in
  on)   rm -f "$UNC_DIR/off"; echo "unc on — ponytail + caveman + codedb enforced." ;;
  off)  : > "$UNC_DIR/off"; echo "unc off — rule silenced (hooks still installed)." ;;
  status) exec "$(dirname "$0")/../hooks/unc-status.sh" ;;
  where)
    echo "log      $LOG"
    echo "flag     $UNC_DIR/off (present = off)" ;;
  uninstall)
    for s in "$UNC_DIR/src/uninstall.sh" "$(dirname "$0")/../uninstall.sh"; do
      [ -f "$s" ] && exec bash "$s" "${2:-}"
    done
    echo "uninstaller not found — grab it: bash <(curl -fsSL https://raw.githubusercontent.com/0ss/unc/main/uninstall.sh)"; exit 1 ;;
  version|--version|-v) echo "unc $VERSION" ;;
  stats)
    case "${2:-}" in --how) how; exit 0 ;; esac
    command -v jq >/dev/null 2>&1 || { echo "need jq for stats"; exit 1; }
    [ -f "$LOG" ] || { echo "no sessions logged yet — go build something."; exit 0; }
    share=0; svg=0
    for a in "$@"; do case "$a" in --share) share=1 ;; --svg) svg=1; share=1 ;; esac; done
    # savings, done honestly — see `unc stats --how` / METHODOLOGY.md.
    #   MEASURED: words-per-line-of-code, on vs off, median, output-only $.
    #     the one thing your own logs can actually prove.
    #   ESTIMATE (seed): your real output tokens * ponytail's published -22%.
    #     labeled "trust me bro" — an extrapolation, not a measurement.
    #   LINES saved is always a ponytail-lab estimate (-54%): no counterfactual.
    price="${UNC_PRICE:-15}"
    min_off="${UNC_MIN_OFF:-3}"
    codeq="${UNC_CODEDB_PER_Q:-1500}"   # tokens a codedb query saves vs grep+full-file read
    result="$(jq -s -r --argjson price "$price" --argjson minoff "$min_off" --argjson share "$share" --argjson svg "$svg" --argjson codeq "$codeq" '
      def k: if . >= 1000 then "\((./1000)|floor)k" else "\(.|floor)" end;
      def usd: (.*100|round/100);
      def clamp: if . < 0 then 0 elif . > 100 then 100 else . end;
      def med($a): ($a|length) as $l
        | if $l==0 then 0 elif ($l%2==1) then $a[($l/2|floor)]
          else (($a[($l/2)-1] + $a[$l/2]) / 2) end;

      # rows are CUMULATIVE per session (running totals), so summing them 10x
      # the number. de-dupe: group by session, take the MAX (= final total) per
      # field, then aggregate across sessions.
      ( length ) as $n
      | ( group_by(.session // .cwd)
          | map({ rule:(.[-1].rule // "on"),
                  out:(map(.out_tokens)|max // 0), inp:(map(.in_tokens)|max // 0),
                  cdb:(map(.codedb // 0)|max // 0),
                  ins:(map(.insertions)|max // 0), del:(map(.deletions)|max // 0) }) ) as $S
      | ( $S | length ) as $nsess
      | ( [ $S[] | select(.rule=="on")  ] ) as $Son
      | ( [ $S[] | select(.rule=="off") ] ) as $Soff
      | ( $Son  | length ) as $non
      | ( $Soff | length ) as $noff
      | ( [ $S[].out ]   | add // 0 ) as $out
      | ( [ $S[].inp ]   | add // 0 ) as $in
      | ( [ $S[].ins ]   | add // 0 ) as $ins
      | ( [ $S[].del ]   | add // 0 ) as $del
      | ( [ $S[].cdb ]   | add // 0 ) as $cdb
      | ( [ $Son[].out ] | add // 0 ) as $out_on
      | ( [ $Son[].ins ] | add // 0 ) as $ins_on
      # words-per-line rates, code sessions only (insertions>0)
      | ( [ $Son[]  | select(.ins>0) | (.out/.ins) ] | sort ) as $onr
      | ( [ $Soff[] | select(.ins>0) | (.out/.ins) ] | sort ) as $offr
      | ( $Soff | length ) as $noffc
      | ( if $noffc >= $minoff and ($onr|length) > 0
          then
            med($offr) as $or | med($onr) as $nr
            | ( if $or > $nr then $or - $nr else 0 end ) as $per
            | ( if $or > 0 then (($or - $nr)/$or*100 | clamp) else 0 end ) as $pct
            | { mode:"measured", ncode:$noffc, rate_on:$nr, rate_off:$or, tokpct:$pct,
                tok: ($per * $ins_on | floor),
                loc: ($ins_on * 0.54/0.46 | floor) }
          else
            { mode:"seed", ncode:$noffc, tokpct:65,
              tok: ($out_on * 0.65/0.35 | floor),
              loc: ($ins_on * 0.54/0.46 | floor) }
          end ) as $s
      | ( $s.tok/1000000*$price ) as $usd
      | ( $cdb * $codeq ) as $cdbsaved
      | ( if $s.mode=="measured"
          then (if $s.ncode>=20 then "solid" elif $s.ncode>=8 then "measured" else "preliminary" end)
          else "estimate" end ) as $conf
      # ansi
      | "[0m" as $x | "[1m" as $b | "[2m" as $d
      | if $svg == 1 then
          "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"860\" height=\"460\" font-family=\"ui-monospace,Menlo,monospace\">"
          + "<defs><linearGradient id=\"bg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\"><stop offset=\"0\" stop-color=\"#0d2018\"/><stop offset=\"1\" stop-color=\"#173a28\"/></linearGradient>"
          + "<linearGradient id=\"hot\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"0\"><stop offset=\"0\" stop-color=\"#5eead4\"/><stop offset=\"1\" stop-color=\"#a7f3c8\"/></linearGradient></defs>"
          + "<rect width=\"860\" height=\"460\" rx=\"28\" fill=\"url(#bg)\"/><rect x=\"7\" y=\"7\" width=\"846\" height=\"446\" rx=\"22\" fill=\"none\" stroke=\"#2f5c43\" stroke-width=\"2\"/>"
          + "<g transform=\"translate(628,52)\">"
          + "<line x1=\"-30\" y1=\"0\" x2=\"150\" y2=\"0\" stroke=\"#4a3d2e\" stroke-width=\"10\" stroke-linecap=\"round\"/>"
          + "<path d=\"M28,10 q-14,-18 -2,-32\" stroke=\"#7a6249\" stroke-width=\"11\" fill=\"none\" stroke-linecap=\"round\"/>"
          + "<path d=\"M92,10 q14,-18 2,-32\" stroke=\"#7a6249\" stroke-width=\"11\" fill=\"none\" stroke-linecap=\"round\"/>"
          + "<ellipse cx=\"60\" cy=\"72\" rx=\"48\" ry=\"54\" fill=\"#7a6249\"/><ellipse cx=\"60\" cy=\"78\" rx=\"34\" ry=\"38\" fill=\"#c4a878\"/>"
          + "<ellipse cx=\"46\" cy=\"72\" rx=\"10\" ry=\"14\" fill=\"#5c4a38\"/><ellipse cx=\"74\" cy=\"72\" rx=\"10\" ry=\"14\" fill=\"#5c4a38\"/>"
          + "<circle cx=\"46\" cy=\"74\" r=\"3.5\" fill=\"#141414\"/><circle cx=\"74\" cy=\"74\" r=\"3.5\" fill=\"#141414\"/>"
          + "<ellipse cx=\"60\" cy=\"86\" rx=\"5\" ry=\"3.5\" fill=\"#3a2e22\"/><path d=\"M52,94 q8,7 16,0\" stroke=\"#5c4a38\" stroke-width=\"2.5\" fill=\"none\" stroke-linecap=\"round\"/>"
          + "</g>"
          + "<text x=\"54\" y=\"80\" fill=\"#7dd6a0\" font-size=\"30\" font-weight=\"bold\">unc wrapped</text>"
          + "<text x=\"56\" y=\"106\" fill=\"#4f7a63\" font-size=\"16\">\($conf) · trust me bro</text>"
          + "<text x=\"52\" y=\"214\" fill=\"url(#hot)\" font-size=\"80\" font-weight=\"bold\">\($s.tok|k)</text>"
          + "<text x=\"58\" y=\"246\" fill=\"#cdeede\" font-size=\"20\">output tokens saved · ~$\($usd|usd)</text>"
          + "<g transform=\"translate(56,290)\" font-size=\"15\">"
          + "<text x=\"0\" y=\"12\" fill=\"#9fe0bd\">output</text><rect x=\"92\" y=\"1\" width=\"320\" height=\"13\" rx=\"6\" fill=\"#1f3a2b\"/><rect x=\"92\" y=\"1\" width=\"\(($s.tokpct/100*320))\" height=\"13\" rx=\"6\" fill=\"#5eead4\"/><text x=\"424\" y=\"12\" fill=\"#6f9a83\">-\($s.tokpct|floor)% caveman</text>"
          + "<text x=\"0\" y=\"40\" fill=\"#9fe0bd\">code</text><rect x=\"92\" y=\"29\" width=\"320\" height=\"13\" rx=\"6\" fill=\"#1f3a2b\"/><rect x=\"92\" y=\"29\" width=\"172\" height=\"13\" rx=\"6\" fill=\"#7dd6a0\"/><text x=\"424\" y=\"40\" fill=\"#6f9a83\">-54% ponytail est</text>"
          + "<text x=\"0\" y=\"68\" fill=\"#9fe0bd\">context</text><rect x=\"92\" y=\"57\" width=\"320\" height=\"13\" rx=\"6\" fill=\"#4f7a63\"/><text x=\"424\" y=\"68\" fill=\"#6f9a83\">codedb leaner in</text>"
          + "</g>"
          + "<text x=\"56\" y=\"426\" fill=\"#4f7a63\" font-size=\"14\">\($n) sessions · github.com/0ss/unc · math → unc stats --how</text>"
          + "</svg>"
        elif $share == 1 then
          # values only — the pretty terminal card is rendered in bash (truecolor)
          "\($s.tok)|\($usd|usd)|\($s.tokpct|floor)|\($conf)|\($n)|\($non)|\($cdb)|\($cdbsaved)"
        else
          ( if $s.mode=="measured"
            then "  🦥 \($b)big unc MEASURED\($x) ~\($s.tok|k) output tokens saved · ~$\($usd|usd)  \($d)(\($conf), n=\($s.ncode))\($x)\n" +
                 "     words/line rule-on \(($s.rate_on*10|round/10)) vs off \(($s.rate_off*10|round/10)) — your own on/off. lines -54% is a ponytail lab est.\n\n"
            else "  🦥 \($b)big unc reckons\($x) ~\($s.tok|k) output tokens saved · ~$\($usd|usd)  \($d)(guesstimate · trust me bro)\($x)\n" +
                 "     caveman -65% output + ponytail -54% code + codedb leaner context. ponytail won'\''t guess live; big unc will — and says so.\n\n"
            end ) +
          "unc stats — \($n) turns across \($nsess) sessions (\($non) on, \($noff) off)\n" +
          "  output tokens   \($out)  \($d)(deduped: max per session, not summed)\($x)\n" +
          "  input tokens    \($in)  \($d)(incl cache — not counted as $ saved)\($x)\n" +
          "  net LOC         \($ins - $del)  (+\($ins) / -\($del))\n" +
          "  codedb queries  \($cdb)  \($d)(~\($cdbsaved|k) tokens not read vs grep+file, est)\($x)\n" +
          "  lines saved     ~\($s.loc)  \($d)(ponytail lab est, -54%)\($x)"
        end
    ' "$LOG")"
    if [ "$svg" = 1 ]; then
      printf '%s\n' "$result" > "$UNC_DIR/receipt.svg"
      echo "🦥 wrote $UNC_DIR/receipt.svg — open it in a browser / screenshot it"
    elif [ "$share" = 1 ]; then
      IFS='|' read -r TOK USD OPCT CONF NS NON CDBQ CDBSAV <<EOF
$result
EOF
      render_card "$TOK" "$USD" "$OPCT" "$CONF" "$NS" "$CDBQ" "$CDBSAV"
    else
      printf '%s\n' "$result"
    fi
    ;;
  help|-h|--help) usage ;;
  *) echo "unknown: $1"; echo; usage; exit 1 ;;
esac
